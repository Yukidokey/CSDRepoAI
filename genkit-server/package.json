{
  "name": "csdrepoai-genkit-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Google Genkit semantic search + embedding service for CSDRepoAI. Provides /search and /embed endpoints backed by Google's gemini-embedding-001 model and Supabase pgvector.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "reindex": "node src/reindexAll.js",
    "genkit:ui": "genkit start -- node src/server.js"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "genkit": "^1.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "genkit-cli": "^1.0.1"
  }
}
